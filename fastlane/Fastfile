require "json"
require "fileutils"
require "shellwords"

default_platform(:ios)

XCODEPROJ = "Impostor.xcodeproj"
SCHEME = "Impostor"
APP_TARGET = "Impostor"
BUNDLE_ID = "net.phor.Impostor"

def xcodeproj_path
  File.expand_path(XCODEPROJ, __dir__ + "/..")
end

def current_marketing_version
  require "xcodeproj"

  project = Xcodeproj::Project.open(xcodeproj_path)
  target = project.targets.find { |candidate| candidate.name == APP_TARGET }
  UI.user_error!("Target #{APP_TARGET} not found in #{xcodeproj_path}") unless target

  target.build_configurations.first.build_settings["MARKETING_VERSION"]
end

def set_marketing_version!(new_version)
  require "xcodeproj"

  project = Xcodeproj::Project.open(xcodeproj_path)
  target = project.targets.find { |candidate| candidate.name == APP_TARGET }
  UI.user_error!("Target #{APP_TARGET} not found in #{xcodeproj_path}") unless target

  target.build_configurations.each do |config|
    config.build_settings["MARKETING_VERSION"] = new_version
  end

  project.save
end

def current_build_number
  get_build_number(xcodeproj: xcodeproj_path).to_i
end

# Simple local build number increment per apple-development skill.
# If upload fails with 'previousBundleVersion' or 'already been used',
# do a one-time fix: set CURRENT_PROJECT_VERSION to remote highest + 1
# in the Xcode project, commit, then resume normal local increments.
def next_build_number
  current_build_number + 1
end

def bump_build_number!(build_number = nil)
  next_build = build_number || next_build_number
  increment_build_number(
    xcodeproj: xcodeproj_path,
    build_number: next_build.to_s
  )
  next_build
end

# Workaround: upload_to_testflight can return a stale previousBundleVersion
# mismatch even when the archive has a higher CFBundleVersion.
def altool_upload!(binary_path, type:)
  config_path = File.expand_path("api_key.json", __dir__)
  UI.user_error!("Missing fastlane/api_key.json") unless File.exist?(config_path)

  config = JSON.parse(File.read(config_path))
  key_id = config.fetch("key_id")
  issuer_id = config.fetch("issuer_id")
  key_filepath = File.expand_path(config.fetch("key_filepath"))
  UI.user_error!("API key file not found at #{key_filepath}") unless File.exist?(key_filepath)

  search_dirs = [
    File.expand_path("~/.appstoreconnect/private_keys"),
    File.expand_path("~/.private_keys"),
    File.expand_path("~/private_keys"),
    File.expand_path("./private_keys")
  ]

  unless search_dirs.any? { |dir| File.exist?(File.join(dir, "AuthKey_#{key_id}.p8")) }
    target_dir = search_dirs.first
    FileUtils.mkdir_p(target_dir)
    FileUtils.cp(key_filepath, File.join(target_dir, "AuthKey_#{key_id}.p8"))
  end

  sh(
    "xcrun altool --upload-app " \
    "-f #{Shellwords.escape(binary_path)} " \
    "-t #{Shellwords.escape(type)} " \
    "--apiKey #{Shellwords.escape(key_id)} " \
    "--apiIssuer #{Shellwords.escape(issuer_id)}"
  )
end

before_all do
  config_path = File.expand_path("api_key.json", __dir__)
  next unless File.exist?(config_path)

  config = JSON.parse(File.read(config_path))
  app_store_connect_api_key(
    key_id: config["key_id"],
    issuer_id: config["issuer_id"],
    key_filepath: config["key_filepath"],
    in_house: config.fetch("in_house", false)
  )
end

desc "Bump the marketing version. Pass bump:patch (default), bump:minor, or bump:major"
lane :bump_version do |options|
  bump_type = options[:bump] || "patch"
  current = current_marketing_version
  parts = current.split(".").map(&:to_i)
  parts << 0 while parts.length < 3

  case bump_type
  when "major"
    parts = [parts[0] + 1, 0, 0]
  when "minor"
    parts = [parts[0], parts[1] + 1, 0]
  else
    parts = [parts[0], parts[1], parts[2] + 1]
  end

  new_version = parts.join(".")
  set_marketing_version!(new_version)
  next_build = bump_build_number!
  UI.success("Bumped to #{new_version} (build #{next_build})")
end

desc "Bump only the build number (used before each beta upload)"
lane :bump_build do |options|
  requested = options[:build_number]&.to_i
  next_build = if requested && requested > 0
    bump_build_number!(requested)
  else
    bump_build_number!
  end
  UI.success("Bumped build number to #{next_build}")
end

platform :ios do
  desc "Capture App Store screenshots. Pass locales:en-US,fr-FR or devices:'iPhone 16 Pro' to filter"
  lane :screenshots do |options|
    args = { scheme: "ImpostorUITests" }
    args[:languages] = options[:locales].to_s.split(",").map(&:strip).reject(&:empty?) if options[:locales]
    args[:devices] = options[:devices].to_s.split(",").map(&:strip).reject(&:empty?) if options[:devices]
    capture_screenshots(args)
  end

  desc "Generate new localized screenshots"
  lane :make_screenshots do
    screenshots
  end

  desc "Upload screenshots to App Store Connect"
  lane :upload_screenshots do
    upload_to_app_store(
      app_version: current_marketing_version,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc "Delete and upload new localized screenshots"
  lane :update_screenshots do
    upload_screenshots
  end

  desc "Generate screenshots and upload them to App Store Connect"
  lane :screenshots_and_upload do
    screenshots
    upload_screenshots
  end

  desc "Build a signed release .ipa and upload it to TestFlight"
  lane :beta do |options|
    requested_build_number = options[:build_number]&.to_i
    build_number = if requested_build_number && requested_build_number > 0
      bump_build_number!(requested_build_number)
    else
      bump_build_number!
    end

    UI.message("Using build number #{build_number}")
    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      destination: "generic/platform=iOS",
      export_xcargs: "-allowProvisioningUpdates",
      clean: true,
      include_bitcode: true,
      output_directory: "build",
      output_name: "Impostor.ipa",
      export_options: {
        uploadSymbols: false
      }
    )

    altool_upload!(File.expand_path("../build/Impostor.ipa", __dir__), type: "ios")
  end

  desc "Submit the latest TestFlight build for review"
  lane :release do |options|
    notes = options[:notes]
    if notes.nil? || notes.strip.empty?
      notes = UI.input("Release notes (What's New) for en-US:")
    end
    UI.user_error!("Release notes are required to submit for review") if notes.nil? || notes.strip.empty?

    selected_build_number = options[:build_number]&.to_s
    selected_build_number = nil if selected_build_number&.strip&.empty?

    upload_to_app_store(
      app_version: current_marketing_version,
      build_number: selected_build_number,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: true,
      overwrite_screenshots: true,
      release_notes: { "en-US" => notes },
      submit_for_review: true,
      automatic_release: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      },
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc "Submit existing metadata with explicit build (skip metadata upload)"
  lane :release_submit_only do |options|
    notes = options[:notes]
    if notes.nil? || notes.strip.empty?
      notes = UI.input("Release notes (What's New) for en-US:")
    end
    UI.user_error!("Release notes are required to submit for review") if notes.nil? || notes.strip.empty?

    selected_build_number = options[:build_number]&.to_s
    UI.user_error!("build_number is required") if selected_build_number.nil? || selected_build_number.strip.empty?

    metadata_dir = File.expand_path("./metadata", __dir__)
    release_notes_by_locale = {}
    Dir.glob(File.join(metadata_dir, "*", "release_notes.txt")).each do |path|
      locale = File.basename(File.dirname(path))
      next if locale == "default"

      content = File.read(path).strip
      next if content.empty?

      release_notes_by_locale[locale] = content
    end
    # Ensure at least one valid What's New payload is always provided.
    release_notes_by_locale["en-US"] = notes

    upload_to_app_store(
      app_version: current_marketing_version,
      build_number: selected_build_number,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      overwrite_screenshots: true,
      release_notes: release_notes_by_locale,
      submit_for_review: true,
      automatic_release: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      },
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc "Run patch bump, TestFlight upload, then App Store submission"
  lane :full_release do |options|
    bump_type = options[:bump] || "patch"
    bump_version(bump: bump_type)

    build_number = options[:build_number]&.to_s
    build_number = nil if build_number&.strip&.empty?

    beta_options = {}
    beta_options[:build_number] = build_number if build_number
    beta(beta_options)

    if options.fetch(:screenshots, true)
      screenshot_options = {
        locales: options[:locales],
        devices: options[:devices]
      }
      screenshots(screenshot_options)
      upload_screenshots
    end

    release_options = {
      notes: options[:notes],
      screenshots: false
    }
    release_options[:build_number] = build_number if build_number
    release(release_options)
  end

  desc "Delete all screenshots from App Store Connect"
  lane :delete_all_screenshots do
    deliver(
      submit_for_review: false,
      skip_metadata: true,
      skip_binary_upload: true,
      screenshots_path: "screenshots/empty-dir",
      force: true
    )
  end
end
